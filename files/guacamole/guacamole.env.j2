# Сгенерировано Ansible из files/guacamole/guacamole.env.j2 (секреты — из vars/guacamole.yml)
TZ={{ guacamole_tz }}
LOG_LEVEL={{ guacamole_log_level }}
GUACD_HOSTNAME=guacd
WEBAPP_CONTEXT={{ guacamole_context }}

# База (MySQL / MariaDB)
MYSQL_HOSTNAME={{ guacamole_db_host }}
MYSQL_PORT={{ guacamole_db_port }}
MYSQL_DATABASE={{ guacamole_db_name }}
MYSQL_USERNAME={{ guacamole_db_user }}
MYSQL_PASSWORD={{ guacamole_db_password }}
MYSQL_SSL_MODE={{ guacamole_db_ssl_mode }}

# Вход через Keycloak (OpenID Connect)
OPENID_ENABLED=true
OPENID_AUTHORIZATION_ENDPOINT={{ keycloak_url }}/realms/{{ keycloak_realm }}/protocol/openid-connect/auth
OPENID_TOKEN_ENDPOINT={{ keycloak_url }}/realms/{{ keycloak_realm }}/protocol/openid-connect/token
OPENID_JWKS_ENDPOINT={{ keycloak_url }}/realms/{{ keycloak_realm }}/protocol/openid-connect/certs
OPENID_ISSUER={{ keycloak_url }}/realms/{{ keycloak_realm }}
OPENID_CLIENT_ID={{ keycloak_client_id }}
OPENID_REDIRECT_URI={{ guacamole_public_url }}
OPENID_SCOPE={{ keycloak_scope }}
OPENID_USERNAME_CLAIM_TYPE={{ keycloak_username_claim }}
OPENID_GROUPS_CLAIM_TYPE={{ keycloak_groups_claim }}
EXTENSION_PRIORITY=openid

# Записи сеансов: просмотр в интерфейсе (История → запись)
RECORDING_SEARCH_PATH=/home/guacd/recordings

# Настоящий IP пользователя из заголовка reverse proxy (в истории подключений и журналах)
REMOTE_IP_VALVE_ENABLED=true
PROXY_IP_HEADER=X-Forwarded-For
PROXY_PROTOCOL_HEADER=X-Forwarded-Proto
